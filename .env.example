# App connects as a DML-only role; migrations run as the schema owner.
# Passwords come from ~/.pgpass (or add them to the URLs outside of git).
DATABASE_URL=postgresql://docforge_app@localhost/docforge
MIGRATE_DATABASE_URL=postgresql://docforge_owner@localhost/docforge
STORAGE_DIR=./data/files
MAX_UPLOAD_BYTES=52428800
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
KOSIT_DIR=./vendor/kosit
# Encrypts stored delivery credentials. Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
DOCFORGE_SECRET_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=reports@example.com
SMTP_STARTTLS=0
SMTP_USER=
SMTP_PASSWORD=
# Only for local testing: allows SFTP delivery to private/loopback hosts.
DELIVERY_ALLOW_PRIVATE=0
# Stored files and finished jobs are deleted after this many days; usage is kept 13 months.
RETENTION_DAYS=30
# json (default) or text
LOG_FORMAT=json
LOG_LEVEL=INFO
# Warm Chromium browsers per API/worker process for HTML renders
RENDER_WORKERS=2
# Warm Typst compiler processes per API/worker process
TYPST_WORKERS=2
# Blob storage: local (STORAGE_DIR) or s3 (any S3-compatible bucket; compose uses MinIO)
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=
S3_ENDPOINT_URL=
MINIO_ROOT_PASSWORD=
